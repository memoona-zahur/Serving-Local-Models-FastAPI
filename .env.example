# Copy this file to .env and fill in the values. NEVER commit .env.
#
# == Hosted backend (works with ANY OpenAI-compatible provider) ==
#
# Option A — Groq (free): https://console.groq.com -> API keys
HOSTED_BASE_URL=https://api.groq.com/openai/v1
HOSTED_API_KEY=gsk_...
HOSTED_MODEL=llama-3.3-70b-versatile
#
# Option B — OpenAI (paid): https://platform.openai.com -> API keys
# HOSTED_BASE_URL=https://api.openai.com/v1
# HOSTED_API_KEY=sk-...
# HOSTED_MODEL=gpt-4o-mini
#
# == Local backend (Ollama) ==
LOCAL_BASE_URL=http://localhost:11434/v1
# any non-empty placeholder is fine; the local server does not check it
LOCAL_API_KEY=ollama
LOCAL_MODEL=llama3.2:3b